{
  "name": "tunebridge",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "dev:worker": "pnpm --filter @tunebridge/worker dev",
    "dev:web": "pnpm --filter @tunebridge/web dev",
    "dev": "concurrently -n worker,web \"pnpm dev:worker\" \"pnpm dev:web\"",
    "deploy": "pnpm --filter @tunebridge/web build && pnpm --filter @tunebridge/worker deploy"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
